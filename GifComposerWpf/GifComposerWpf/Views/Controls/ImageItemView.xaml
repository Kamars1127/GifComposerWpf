<UserControl x:Class="GifComposerWpf.Views.Controls.ImageItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GifComposerWpf.Views.Controls"
             xmlns:vm="clr-namespace:GifComposerWpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="83" d:DesignWidth="389"
             d:DataContext="{d:DesignInstance Type=vm:ImageItemViewModel}"
             Background="#5B6194"
             FontFamily="Noto Sans TC"
             FontSize="16"
             Foreground="White">

    <Border BorderThickness="1" BorderBrush="#6E739E" Padding="20,10,12,10"
            Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=Background}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="29"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{DynamicResource titleStyle}" Text="{Binding Order}"/>
            <Image Grid.Column="2" Width="64" Height="64" Source="{Binding Thumbnail}"/>
            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource labelStyle}" Width="110" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource labelStyle}" Text="{Binding Width}"/>
                    <TextBlock Style="{DynamicResource labelStyle}" Text=" x "/>
                    <TextBlock Style="{DynamicResource labelStyle}" Text="{Binding Height}"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="6">
                <Border BorderBrush="{StaticResource grayBorder}" BorderThickness="1" Width="88" Height="28"
                    CornerRadius="5">
                    <TextBlock Margin="0,0,4,0" Style="{DynamicResource labelStyle}" HorizontalAlignment="Right" Text="ms"/>
                </Border>
                <TextBox Style="{DynamicResource inputRadiusStyle}" HorizontalAlignment="Left" Width="59" Height="28"/>
            </Grid>

            <Button Grid.Column="8" Style="{StaticResource iconBtnNoBgStyle}"
                Content="LockOpen"/>
        </Grid>
    </Border>
</UserControl>
