<Window x:Class="GifComposerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icon="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:local="clr-namespace:GifComposerWpf"
        xmlns:vm="clr-namespace:GifComposerWpf.ViewModels"
        xmlns:controls="clr-namespace:GifComposerWpf.Views.Controls"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:behaviors ="clr-namespace:GifComposerWpf.Behaviors"
        xmlns:res="clr-namespace:GifComposerWpf.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Gif 產生器 v1.0.0" Height="830" Width="1305"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource mainBg}"
        FontFamily="Noto Sans TC"
        FontSize="16"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左區塊 -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Margin="17,0,24,0" Style="{DynamicResource iconTextBtnStyle}"
                        Tag="AddCircle"
                        Content="新增圖片" Command="{Binding LoadImagesCommand}"/>

                <Button Style="{DynamicResource iconTextBtnStyle}"
                        Tag="Delete"
                        Content="全部刪除" Command="{Binding ClearAllImagesCommand}"/>
            </StackPanel>

            <Border Grid.Row="2" Padding="15,10,0,15" BorderThickness="1" BorderBrush="White" CornerRadius="5"
                    Background="{StaticResource subBlockBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource titleStyle}" Text="圖片列表"/>
                        <TextBlock Margin="6,0,0,0" Style="{DynamicResource titleStyle}" Text="("/>
                        <TextBlock Style="{DynamicResource titleStyle}" Text="{Binding Images.Count}"/>
                        <TextBlock Style="{DynamicResource titleStyle}" Text=")"/>
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Images}"
                             SelectionMode="Single" Background="Transparent" BorderThickness="0"
                             dd:DragDrop.IsDragSource="True"
                             dd:DragDrop.IsDropTarget="True"
                             dd:DragDrop.DropHandler="{Binding ImageItemDropHandler}"
                             dd:DragDrop.DropTargetAdornerBrush="#F5F25E"
                             SelectedItem="{Binding SelectedImage}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>

                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#B490FC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:ImageItemView Margin="0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Button Style="{DynamicResource iconTextBtnStyle}" Tag="Delete" Content="刪除"
                        Command="{Binding RemoveSelectedImageCommand}"/>
                <Button Grid.Column="2" Style="{DynamicResource iconTextBtnStyle}" Tag="ChevronUp" Content="上移"
                        Command="{Binding MoveImageUpCommand}"/>
                <Button Grid.Column="4" Style="{DynamicResource iconTextBtnStyle}" Tag="ChevronDown" Content="下移"
                        Command="{Binding MoveImageDownCommand}"/>
            </Grid>

            <Grid Grid.Row="6"
                  dd:DragDrop.IsDropTarget="True"
                  dd:DragDrop.DropHandler="{Binding ImageFileDropHandler}"
                  behaviors:DragHoverBehavior.Enable="True"
                  behaviors:DragHoverBehavior.IsDragOver="{Binding IsImageDragOver}">
                <Rectangle RadiusX="8" RadiusY="8">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="#C9C9C9"/>
                            <Setter Property="StrokeThickness" Value="2"/>
                            <Setter Property="Stroke" Value="{StaticResource blackGrayFont}"/>
                            <Setter Property="StrokeDashArray" Value="5 8"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImageDragOver}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource pressedBd}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,48">
                    <icon:SymbolIcon Symbol="ImageAdd" FontSize="64" Foreground="{StaticResource blackGrayFont}"/>
                    <StackPanel Margin="12,0">
                        <TextBlock Style="{DynamicResource hintTextStyle}"  Text="拖曳圖片到此處"/>
                        <TextBlock Margin="0,16,0,0" Style="{DynamicResource hintTextStyle}"  Text="支援 PNG、JPG、JPEG、BMP、WebP"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 右區塊 -->
        <Grid Grid.Row="1" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- 預覽 -->
            <Border Padding="15,10,15,15" BorderThickness="1" BorderBrush="White" CornerRadius="5"
                    Background="{StaticResource subBlockBg}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource titleStyle}" >
                            <Run Text="預覽 "/>
                            <Run Text="("/>
                            <Run Text="{Binding OutputWidth}"/>
                            <Run Text=" x "/>
                            <Run Text="{Binding OutputHeight}"/>
                            <Run Text=")"/>
                    </TextBlock>
                    <Border Margin="0,10" Width="640" Height="360" Background="#D9D9D9">
                        <Viewbox Stretch="Uniform">
                            <Border Width="{Binding OutputWidth}" Height="{Binding OutputHeight}">
                                <Image Stretch="Uniform" Source="{Binding PreviewImage}"/>
                            </Border>
                        </Viewbox>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource iconBtnStyle}" Content="Play" Command="{Binding PlayPreviewCommand}"/>
                        <Button Margin="10,0,17,0" Style="{DynamicResource iconBtnStyle}" Content="Pause" Command="{Binding PausePreviewCommand}"/>
                        <TextBlock Style="{DynamicResource labelStyle}" Text="{Binding CurrentPreviewNumber}"/>
                        <TextBlock Margin="2,0" Style="{DynamicResource labelStyle}" Text="/"/>
                        <TextBlock Style="{DynamicResource labelStyle}" Text="{Binding Images.Count}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <!-- 尺寸 -->
                <Border  Padding="15,10,15,15" BorderThickness="1" BorderBrush="White" CornerRadius="5"
                         Background="{StaticResource subBlockBg}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="4" Style="{DynamicResource titleStyle}" Text="輸出尺寸"/>
                        
                        <RadioButton Grid.Row="2" Grid.Column="1"
                                     Style="{DynamicResource commRadioBtnStyle}"
                                     GroupName="SizeGroup" IsChecked="True" Content="第一張圖片尺寸"
                                     Command="{Binding ChangeSizeModeCommand}"
                                     CommandParameter="{x:Static res:GifSizeMode.FirstImage}"/>
                        
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Margin="0,0,12,0" GroupName="SizeGroup" Content="常用尺寸"
                                         Style="{DynamicResource commRadioBtnStyle}"
                                         Command="{Binding ChangeSizeModeCommand}"
                                         CommandParameter="{x:Static res:GifSizeMode.Preset}"/>
                            <ComboBox IsEnabled="{Binding IsEnablePresetSize}" Width="134" 
                                      ItemsSource="{x:Static res:PublicData.PresetSizeList}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedPresetSize}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                            <RadioButton GroupName="SizeGroup" Content="自訂尺寸"
                                         Style="{DynamicResource commRadioBtnStyle}"
                                         Command="{Binding ChangeSizeModeCommand}"
                                         CommandParameter="{x:Static res:GifSizeMode.Custom}"/>
                            <TextBox IsEnabled="{Binding IsEnableCustomSize}" Margin="12,0,3,0" Width="60"
                                     Style="{DynamicResource inputRadiusStyle}"
                                     Text="{Binding OutputWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="0,0,3,0" Style="{DynamicResource labelStyle}" Text="x"/>
                            <TextBox IsEnabled="{Binding IsEnableCustomSize}" Width="60"
                                     Style="{DynamicResource inputRadiusStyle}"
                                     Text="{Binding OutputHeight, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- 循環播放 -->
                <Border Margin="20,0" Padding="15,10,15,15" BorderThickness="1" BorderBrush="White" CornerRadius="5"
                        Background="{StaticResource subBlockBg}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource titleStyle}" Text="循環播放"/>
                        <RadioButton Margin="14,15" Style="{DynamicResource commRadioBtnStyle}"
                                     GroupName="LoopGroup" Content="無限循環"
                                     Command="{Binding ChangeLoopModeCommand}"
                                     CommandParameter="{x:Static res:GifLoopMode.Infinite}"/>

                        <StackPanel Margin="14,0,0,0" Orientation="Horizontal">
                            <RadioButton Style="{DynamicResource commRadioBtnStyle}" IsChecked="True"
                                         GroupName="LoopGroup" Content="自訂次數"
                                         Command="{Binding ChangeLoopModeCommand}"
                                         CommandParameter="{x:Static res:GifLoopMode.Custom}"/>
                            <TextBox Margin="12,0" Width="60" IsEnabled="{Binding IsEnableCustomLoopCountBox}"
                                     Style="{DynamicResource inputRadiusStyle}"
                                     Text="{Binding CustomLoopCount}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>  
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- 檔案輸出路徑 -->
                <Border Padding="15,10" BorderThickness="1" BorderBrush="White" CornerRadius="5"
                         Background="{StaticResource subBlockBg}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{DynamicResource labelStyle}" Text="輸出入徑:"/>
                        <TextBox Grid.Column="2" IsReadOnly="True" Style="{DynamicResource inputRadiusStyle}" Text="{Binding OutputPath}" FontSize="14"/>
                        <Button Grid.Column="4" Style="{DynamicResource iconTextBtnStyle}"
                                Tag="FolderOpen" Content="瀏覽"
                                Command="{Binding SetOutputPathCommand}"/>
                    </Grid>
                </Border>

                <Button Grid.Column="2" Style="{DynamicResource createBtnStyle}" Content="產生" Tag="Gif"
                        Command="{Binding CreateGifCommand}"/>
            </Grid>
        </Grid>

       
    </Grid>
</Window>