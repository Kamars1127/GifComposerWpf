<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icon="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">
    <Style x:Key="iconTextBtnStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource commBtnBd}"/>
        <Setter Property="Padding" Value="15,10"/>
        <Setter Property="Background" Value="{StaticResource commBtnBg}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <icon:SymbolIcon Margin="0,0,12,0" Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                             Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="content"/>
                        </StackPanel>
                        
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource hoverBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource blackFont}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource hoverBd}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource pressedBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource blackFont}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource pressedBd}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource disableBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource disableBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="iconBtnStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource commBtnBd}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Background" Value="{StaticResource commBtnBg}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <icon:SymbolIcon Symbol="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                         Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource hoverBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource blackFont}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource hoverBd}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource pressedBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource blackFont}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource pressedBd}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="iconBtnNoBgStyle" TargetType="Button">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Background" Value="{StaticResource commBtnBg}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <icon:SymbolIcon Symbol="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource hoverBg}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource pressedBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="imageItemIconBtnStyle" TargetType="Button" BasedOn="{StaticResource iconBtnNoBgStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=IsSelected}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource blackFont}"/>
            </DataTrigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource hoverBg}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{StaticResource pressedBg}"/>
            </Trigger>

        </Style.Triggers>
    </Style>
</ResourceDictionary>